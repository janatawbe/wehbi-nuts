APP_NAME="Wehbi Nuts API"
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL connection string (SQLAlchemy 2.x + psycopg driver).
# Replace username/password/db name with your local PostgreSQL setup.
# Never commit real credentials.
DATABASE_URL=postgresql+psycopg://wehbi_nuts:changeme@localhost:5432/wehbi_nuts

# Digitizer upload settings (Milestone 3).
# DIGITIZER_UPLOAD_DIR may be relative (to server/) or an absolute path.
DIGITIZER_UPLOAD_DIR=uploads/digitizer
DIGITIZER_MAX_FILE_SIZE_BYTES=10485760
DIGITIZER_MAX_IMAGES_PER_JOB=20
DIGITIZER_MAX_IMAGE_DIMENSION=8000
